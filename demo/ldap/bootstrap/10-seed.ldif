twakeDepartmentPath: organization
twakeAccountStatus: cn=active,ou=twakeAccountStatus,ou=nomenclature,dc=tmail,dc=com
twakeDeliveryMode: cn=normal,ou=twakeDeliveryMode,ou=nomenclature,dc=tmail,dc=com


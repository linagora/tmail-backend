<?xml version="1.0"?>

<!-- Submission proxy listeners for the tests, on ephemeral ports: STARTTLS, implicit TLS, and       -->
<!-- clear text behind an HAProxy PROXY protocol header.                                              -->

<smtpservers>
    <smtpserver enabled="true">
        <jmxName>submission-starttls</jmxName>
        <bind>127.0.0.1:0</bind>
        <connectionBacklog>200</connectionBacklog>
        <tls socketTLS="false" startTLS="true">
            <keystore>classpath://keystore</keystore>
            <secret>james72laBalle</secret>
            <provider>org.bouncycastle.jce.provider.BouncyCastleProvider</provider>
        </tls>
        <connectiontimeout>360</connectiontimeout>
        <connectionLimit>0</connectionLimit>
        <connectionLimitPerIP>0</connectionLimitPerIP>
        <helloName autodetect="false">submission.proxy.tld</helloName>
        <smtpGreeting>Twake Mail submission proxy</smtpGreeting>
    </smtpserver>
    <smtpserver enabled="true">
        <jmxName>submission-implicit-tls</jmxName>
        <bind>127.0.0.1:0</bind>
        <connectionBacklog>200</connectionBacklog>
        <tls socketTLS="true" startTLS="false">
            <keystore>classpath://keystore</keystore>
            <secret>james72laBalle</secret>
            <provider>org.bouncycastle.jce.provider.BouncyCastleProvider</provider>
        </tls>
        <connectiontimeout>360</connectiontimeout>
        <connectionLimit>0</connectionLimit>
        <connectionLimitPerIP>0</connectionLimitPerIP>
        <helloName autodetect="false">submission.proxy.tld</helloName>
        <smtpGreeting>Twake Mail submission proxy</smtpGreeting>
    </smtpserver>
    <smtpserver enabled="true">
        <jmxName>submission-haproxy</jmxName>
        <bind>127.0.0.1:0</bind>
        <connectionBacklog>200</connectionBacklog>
        <proxyRequired>true</proxyRequired>
        <tls socketTLS="false" startTLS="false"/>
        <connectiontimeout>360</connectiontimeout>
        <connectionLimit>0</connectionLimit>
        <connectionLimitPerIP>0</connectionLimitPerIP>
        <helloName autodetect="false">submission.proxy.tld</helloName>
        <smtpGreeting>Twake Mail submission proxy</smtpGreeting>
    </smtpserver>
</smtpservers>

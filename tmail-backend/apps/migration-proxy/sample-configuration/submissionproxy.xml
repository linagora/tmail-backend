<?xml version="1.0"?>

<!-- Listeners of the optional SMTP submission proxy (submission.enabled=true in                       -->
<!-- migrationproxy.properties). Same syntax as smtpserver.xml, but the command set is fixed: EHLO,    -->
<!-- HELO, STARTTLS, AUTH, NOOP, RSET, QUIT. Once authenticated against its backend, the connection is -->
<!-- relayed raw. To enable STARTTLS (587) or implicit TLS (465), set <tls startTLS|socketTLS="true">  -->
<!-- with a keystore. helloName is the name the proxy uses in its own EHLO to the backends.           -->

<smtpservers>
    <smtpserver enabled="true">
        <jmxName>submission-proxy</jmxName>
        <bind>0.0.0.0:587</bind>
        <connectionBacklog>200</connectionBacklog>
        <!-- Set to true to accept the HAProxy PROXY protocol from an upstream load balancer -->
        <proxyRequired>false</proxyRequired>
        <tls socketTLS="false" startTLS="false">
            <keystore>file://conf/keystore</keystore>
            <secret>migrationproxy</secret>
            <provider>org.bouncycastle.jce.provider.BouncyCastleProvider</provider>
        </tls>
        <connectiontimeout>360</connectiontimeout>
        <connectionLimit>0</connectionLimit>
        <connectionLimitPerIP>0</connectionLimitPerIP>
        <helloName autodetect="true">localhost</helloName>
        <smtpGreeting>Twake Mail submission proxy</smtpGreeting>
    </smtpserver>
</smtpservers>
